{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/art/*", "/privacy/*", "/terms/*", "/*.{css,js,map,webp,svg,json}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": { ".webp": "image/webp" }
}
